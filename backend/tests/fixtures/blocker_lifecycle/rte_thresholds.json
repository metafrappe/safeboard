  "note": "Sahte RTE kaydı. Sayılar yalnız test içindir. Gerçek eşiği Team SAFe RTE yazar.",
  "fake": true,
  "version": 0,
  "kaizenRules": {
    "setBy": "sahte kayıt",
    "period": {
